{
  "compilerOptions": {
    "noErrorTruncation": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "target": "es2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "typeRoots": [
      "node_modules/@types",
      "./typedefs"
    ],
    "lib": [
      "dom",
      "es2022",
      "esnext.disposable"
    ],
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": [
    "./eslint.config.mjs",
    "scripts",
    "src",
    "test",
    "bin",
    "typedefs/**/*.ts"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
